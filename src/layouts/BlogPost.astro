---
import FormattedDate from "../components/FormattedDate.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../utils/urls";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
  wordCount: number;
  /** Directory path of the post, shown as breadcrumb. */
  crumbs: string[];
}

const { title, description, pubDate, updatedDate, tags = [], headings, wordCount, crumbs } =
  Astro.props;

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const readingTime = Math.max(1, Math.round(wordCount / 350));
---

<Layout title={`${title} | Sirius`} description={description} hasSidebar>
  <div>
    <div class="page-title text-foreground/60 font-sans">
      <span class="inline-flex items-center gap-2">
        <Icon name="web" class="shrink-0" />
        {crumbs.length > 0 ? crumbs.join(" / ") : "Post"}
      </span>
    </div>
  </div>

  <article class="mt-2">
    <h1 class="text-xl md:text-3xl font-extrabold"><span>{title}</span></h1>

    <div class="post-meta font-sans text-foreground/60 text-sm mt-4">
      <p class="flex flex-wrap items-center gap-4 mb-2">
        <span class="date flex gap-1 items-center shrink-0">
          <Icon name="calendar" />
          <time><FormattedDate date={pubDate} /></time>
        </span>
        {
          updatedDate && (
            <span class="inline-flex items-center gap-1">
              <Icon name="time" />
              <span>
                updated <FormattedDate date={updatedDate} />
              </span>
            </span>
          )
        }
        <span class="inline-flex items-center gap-1">
          <Icon name="text" />
          <span>{wordCount} words</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <Icon name="time" />
          <span>{readingTime} min</span>
        </span>
        <a class="smooth-underline" href="https://creativecommons.org/licenses/by-sa/4.0/">
          <span class="inline-flex items-center gap-1">
            <Icon name="cc" />
            <span>CC BY-SA 4.0</span>
          </span>
        </a>
      </p>
      <p class="flex flex-wrap items-center gap-4">
        <span class="flex flex-wrap max-w-full gap-4">
          {
            tags.map((tag) => (
              <a class="tag flex items-center gap-1 smooth-underline truncate" href={withBase("/tags/")}>
                <Icon name="tag-single" class="shrink-0" />
                <span class="truncate">{tag}</span>
              </a>
            ))
          }
        </span>
      </p>
    </div>

    <div class="markdown-body is-detailed">
      <slot />
    </div>
  </article>

  <!-- Mobile: floating button toggling the sidebar TOC drawer -->
  <button
    id="toc-toggle"
    aria-label="Toggle table of contents"
    class="fixed bottom-4 right-4 z-50 md:hidden bg-background border border-background-border rounded-full p-3 shadow-lg hover:bg-primary/10 hover:text-primary transition"
  >
    <Icon name="menu" />
  </button>

  <Fragment slot="sidebar">
    <div class="font-sans">
      <span class="inline-flex items-center gap-1 text-sm opacity-60 pb-1">
        <Icon name="menu" class="shrink-0" />
        <span>Menu</span>
      </span>
      <div id="page-toc">
        <ul class="w-full font-sans">
          {
            toc.map((h) => (
              <li
                class="toc-item flex items-center transition relative text-foreground/60 [&.active-now]:text-primary-700 [&.active-now]:font-bold px-2 py-1 hover:bg-primary/10 hover:text-primary rounded-sm"
                style={`padding-left: ${(h.depth - 2) * 0.75 + 0.5}rem;`}
              >
                <a class="block truncate w-full" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Fragment>
</Layout>

<script>
  // Heading anchor links (visible on hover, like the reference theme)
  const anchorSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="0.8em" height="0.8em" fill="currentColor"><path d="M7.775 3.275a.75.75 0 0 0 1.06 1.06l1.25-1.25a2 2 0 1 1 2.83 2.83l-2.5 2.5a2 2 0 0 1-2.83 0 .75.75 0 0 0-1.06 1.06 3.5 3.5 0 0 0 4.95 0l2.5-2.5a3.5 3.5 0 0 0-4.95-4.95zm-4.69 9.64a2 2 0 0 1 0-2.83l2.5-2.5a2 2 0 0 1 2.83 0 .75.75 0 0 0 1.06-1.06 3.5 3.5 0 0 0-4.95 0l-2.5 2.5a3.5 3.5 0 0 0 4.95 4.95l1.25-1.25a.75.75 0 0 0-1.06-1.06l-1.25 1.25a2 2 0 0 1-2.83 0"/></svg>`;
  for (const h of document.querySelectorAll<HTMLHeadingElement>(".markdown-body h2, .markdown-body h3, .markdown-body h4")) {
    if (!h.id) continue;
    const anchor = document.createElement("a");
    anchor.className = "anchor";
    anchor.href = `#${h.id}`;
    anchor.innerHTML = anchorSvg;
    h.prepend(anchor);
  }

  // Scrollspy: highlight the current section in the sidebar TOC
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>("#page-toc a")];
  const byId = new Map(tocLinks.map((a) => [a.getAttribute("href")!.slice(1), a]));
  const setActive = (id: string) => {
    for (const a of byId.values()) a.parentElement?.classList.remove("active-now");
    byId.get(id)?.parentElement?.classList.add("active-now");
  };
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
    },
    { rootMargin: "-80px 0px -70% 0px" },
  );
  byId.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Mobile TOC drawer
  document.getElementById("toc-toggle")?.addEventListener("click", () => {
    document.body.classList.toggle("show-toc");
  });
</script>
