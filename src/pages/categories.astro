---
import CategoryTree, { type TreeNode } from "../components/CategoryTree.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Build a tree from the directory structure of post IDs
// (e.g. "rust/unsafe/aliasing" -> rust > unsafe > post).
const root: TreeNode = { name: "", children: [], posts: [] };
for (const post of posts) {
  const segments = post.id.split("/");
  let node = root;
  for (const dir of segments.slice(0, -1)) {
    let child = node.children.find((c) => c.name === dir);
    if (!child) {
      child = { name: dir, children: [], posts: [] };
      node.children.push(child);
    }
    node = child;
  }
  node.posts.push({ slug: post.id, title: post.data.title });
}

// `tree`-style summary footer.
const countDirs = (n: TreeNode): number =>
  n.children.length + n.children.reduce((sum, c) => sum + countDirs(c), 0);
const dirCount = countDirs(root);
const fileCount = posts.length;
---

<Layout title="Categories | Sirius" description="All posts grouped by directory tree.">
  <article>
    <div>
      <h1 class="page-title text-foreground/60 font-sans text-[22px] md:text-[32px] font-extrabold">
        <span class="inline-flex items-center gap-2">
          <Icon name="folder-open" class="shrink-0" />
          Categories
        </span>
      </h1>
    </div>
    <div class="tree-body">
      <CategoryTree node={root} isRoot />
      <div class="tree-row tree-summary">
        <span>
          {dirCount}{" "}{dirCount === 1 ? "directory" : "directories"},{" "}{fileCount}{" "}{fileCount === 1 ? "file" : "files"}
        </span>
      </div>
    </div>
  </article>
</Layout>
