---
import Icon from "../components/Icon.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { SITE_SIGNATURE, SOCIAL_LINKS } from "../consts";
import Layout from "../layouts/Layout.astro";

const changelog = [
  {
    date: "2026-08-16",
    content: "Redesigned the blog after the Krypton 2 theme; added KaTeX and rainbow code brackets.",
  },
  {
    date: "2026-08-16",
    content: "Migrated the package manager from Bun to pnpm and upgraded to Astro 7.",
  },
  {
    date: "2026-02-14",
    content: "v1: Selected fonts and colors, implemented layout design and deployed to GitHub Pages.",
  },
  {
    date: "2026-02-10",
    content: "Initial commit. Scaffolded the structure using Astro and Tailwind.",
  },
];
---

<Layout title="About | Sirius" description="About this site and its history.">
  <article>
    <div>
      <h1 class="page-title text-foreground/60 font-sans text-xl md:text-3xl font-extrabold">
        <span class="inline-flex items-center gap-2">
          <Icon name="user" class="shrink-0" />
          About
        </span>
      </h1>
    </div>

    <div class="markdown-body is-detailed mt-4">
      <p class="text-lg">{SITE_SIGNATURE}</p>
      <p>Personal playground to dump my thoughts and handicrafts.</p>

      <div class="flex justify-start gap-4 mt-4">
        {
          SOCIAL_LINKS.map((link) => (
            <a
              href={link.url}
              title={link.label}
              class="text-foreground/70 hover:text-primary transition-colors"
            >
              <span class="sr-only">{link.label}</span>
              <SocialIcon platform={link.name} />
            </a>
          ))
        }
      </div>

      <h2>Changelog</h2>
      <div class="tip">
        <ul>
          {
            changelog.map((item) => (
              <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                <span class="shrink-0 font-sans text-sm text-foreground/60">{item.date}</span>
                <span>{item.content}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </article>
</Layout>
