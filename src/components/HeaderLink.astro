---
import { withBase } from "../utils/urls";
import Icon from "./Icon.astro";

interface Props {
  href: string;
  icon: string;
  label: string;
}

const { href, icon, label } = Astro.props;
const internalHref = withBase(href);

const normalize = (path: string) => path.replace(/\/+$/, "");
const isActive =
  normalize(Astro.url.pathname) === normalize(internalHref) ||
  (href !== "/" && Astro.url.pathname.startsWith(internalHref));
---

<a
  href={internalHref}
  class:list={[
    "header-link flex items-center justify-center gap-1 transition rounded px-2 py-1 md:h-10 md:w-full hover:bg-primary/10 hover:text-primary",
    isActive && "text-primary bg-primary/10",
  ]}
  aria-current={isActive ? "page" : undefined}
>
  <Icon name={icon} class="shrink-0" />
  <span class="hidden lg:inline">{label}</span>
</a>
