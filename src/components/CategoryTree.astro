---
import { withBase } from "../utils/urls";

export interface TreePost {
  slug: string;
  title: string;
}

export interface TreeNode {
  name: string;
  children: TreeNode[];
  posts: TreePost[];
}

interface Props {
  node: TreeNode;
  /** Box-drawing prefix inherited from ancestors (e.g. "│   "). */
  prefix?: string;
  /** Whether this entry is the last one among its siblings. */
  isLast?: boolean;
  /** Render the "." root line instead of a branch + directory name. */
  isRoot?: boolean;
}

const { node, prefix = "", isLast = true, isRoot = false } = Astro.props;

// `tree` lists directories first, then files, both alphabetically.
const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: "base" });
const dirs = [...node.children].sort((a, b) => collator.compare(a.name, b.name));
const files = [...node.posts].sort((a, b) => collator.compare(a.title, b.title));

type Entry =
  | { kind: "dir"; node: TreeNode; isLast: boolean }
  | { kind: "file"; post: TreePost; isLast: boolean };

const entries: Entry[] = [
  ...dirs.map((child, i): Entry => ({
    kind: "dir",
    node: child,
    isLast: i === dirs.length - 1 && files.length === 0,
  })),
  ...files.map((post, i): Entry => ({ kind: "file", post, isLast: i === files.length - 1 })),
];

const descendantPrefix = isRoot ? "" : `${prefix}${isLast ? "    " : "│   "}`;
---

{
  isRoot ? (
    <div class="tree-row">
      <span class="tree-guide">.</span>
    </div>
  ) : (
    <div class="tree-row">
      <span class="tree-guide" aria-hidden="true">
        {prefix}
        {isLast ? "└── " : "├── "}
      </span>
      <span class="tree-dir">{node.name}</span>
    </div>
  )
}
{
  entries.map((entry) =>
    entry.kind === "dir" ? (
      <Astro.self node={entry.node} prefix={descendantPrefix} isLast={entry.isLast} />
    ) : (
      <div class="tree-row">
        <span class="tree-guide" aria-hidden="true">
          {descendantPrefix}
          {entry.isLast ? "└── " : "├── "}
        </span>
        <a class="tree-file smooth-underline" href={withBase(`/blog/${entry.post.slug}/`)}>
          {entry.post.title}
        </a>
      </div>
    ),
  )
}
